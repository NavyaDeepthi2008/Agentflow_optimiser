    {
      "id": "freshness_read_after_write",
      "category": "freshness",
      "split": "heldout",
      "task": "Mark ticket REC-1001 as resolved, then confirm its current status by reading it again.",
      "tools": [
        "record_read",
        "record_update"
      ],
      "allow_side_effects": true,
      "script": [
        {
          "tool_calls": [
            {
              "name": "record_read",
              "args": {
                "record_id": "REC-1001"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "record_update",
              "args": {
                "record_id": "REC-1001",
                "field": "status",
                "value": "resolved"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "record_read",
              "args": {
                "record_id": "REC-1001"
              }
            }
          ]
        },
        {
          "answer_template": "REC-1001 is now {s}.",
          "values": {
            "s": {
              "tool": "record_read",
              "path": "result.status"
            }
          }
        }
      ],
      "expected": {
        "answer": {
          "contains_all": [
            "resolved"
          ]
        },
        "world": [
          {
            "record": "REC-1001",
            "field": "status",
            "equals": "resolved"
          }
        ]
      }
    },
    {
      "id": "side_effect_double_reminder",
      "category": "side_effect",
      "split": "train",
      "task": "Send the message 'Standup at 10' to team:orbit twice, as two separate notifications.",
      "tools": [
        "send_notification"
      ],
      "allow_side_effects": true,
      "script": [
        {
          "tool_calls": [
            {
              "name": "send_notification",
              "args": {
                "recipient": "team:orbit",
                "message": "Standup at 10"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "send_notification",
              "args": {
                "recipient": "team:orbit",
                "message": "Standup at 10"
              }
            }
          ]
        },
        {
          "answer_template": "Sent the reminder twice (last message id {m}).",
          "values": {
            "m": {
              "tool": "send_notification",
              "path": "result.message_id"
            }
          }
        }
      ],
      "expected": {
        "answer": {
          "contains_all": [
            "twice",
            "MSG-0002"
          ]
        },
        "world": [
          {
            "outbox_count": 2
          }
        ]
      }
    },
    {
      "id": "side_effect_close_and_notify",
      "category": "side_effect",
      "split": "heldout",
      "task": "Close ticket REC-1002 and notify team:keystone that it was closed.",
      "tools": [
        "record_update",
        "send_notification"
      ],
      "allow_side_effects": true,
      "script": [
        {
          "tool_calls": [
            {
              "name": "record_update",
              "args": {
                "record_id": "REC-1002",
                "field": "status",
                "value": "closed"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "send_notification",
              "args": {
                "recipient": "team:keystone",
                "message": "REC-1002 was closed"
              }
            }
          ]
        },
        {
          "answer_template": "REC-1002 is {s} and team:keystone was notified.",
          "values": {
            "s": {
              "tool": "record_update",
              "path": "result.status"
            }
          }
        }
      ],
      "expected": {
        "answer": {
          "contains_all": [
            "closed",
            "notified"
          ]
        },
        "world": [
          {
            "record": "REC-1002",
            "field": "status",
            "equals": "closed"
          },
          {
            "outbox_count": 1
          }
        ]
      }
    },
