# Copy this file to backend/.env and fill in your own values.
# backend/.env is git-ignored. Never commit a real key.

# Google Gemini API key (from Google AI Studio). Leave empty to use ScriptedLLM only.
GEMINI_API_KEY=

# Gemini model id. Check Google's model list for currently available models.
GEMINI_MODEL=gemini-3.5-flash

# Optional. Leave empty to use the provider default (recommended for Gemini 3 models).
GEMINI_TEMPERATURE=
# Optional: minimal | low | medium | high. Leave empty for the model default.
GEMINI_THINKING_LEVEL=
GEMINI_MAX_OUTPUT_TOKENS=4096
LLM_TIMEOUT_SECONDS=45

# Agent limits (applied identically in baseline and optimized modes)
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_REQUESTS=20
AGENT_RUN_TIMEOUT_SECONDS=90

# Persistence and API
DATABASE_URL=sqlite:///./agentflow.db
MAX_CONCURRENT_RUNS=2
MAX_SESSIONS=100

# Optional: path to a pricing JSON (copy pricing.example.json and fill in CURRENT prices
# from the provider's pricing page). Leave empty: cost is reported as unavailable.
PRICING_FILE=

# Browser origins allowed to call the API (comma-separated; '*' is rejected)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to 1 to run the optional live tests (they call the real API and cost money)
RUN_LIVE_TESTS=0
