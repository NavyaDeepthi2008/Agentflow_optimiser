    {
      "cache_scope": "session",
      "description": "Get the current price of a fictional instrument. Prices change every few minutes.",
      "effect": "read_only",
      "effective_cache_scope": "session",
      "effective_ttl_seconds": 60.0,
      "freshness": "ttl",
      "learned_rules": [],
      "learning_eligible": true,
      "max_ttl_seconds": 300.0,
      "name": "price_lookup",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "force_fresh": {
            "description": "Optional. Set to true only if you need a newer result than one already obtained for the same request.",
            "type": "boolean"
          },
          "symbol": {
            "description": "Fictional instrument symbol, e.g. 'NMB-X'. Available: NMB-X, ORB-X, KST-X.",
            "pattern": "^[A-Z]{3}-X$",
            "type": "string"
          }
        },
        "required": [
          "symbol"
        ],
        "type": "object"
      },
      "requires_permission": false,
      "timeout_seconds": 5.0,
      "ttl_seconds": 60.0
    },
    {
