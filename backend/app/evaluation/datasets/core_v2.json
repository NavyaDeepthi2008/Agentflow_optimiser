{
  "name": "core",
  "version": "2",
  "description": "AgentFlow core evaluation set over the fictional Nimbus Labs mock tools. Expected answers and world checks are never shown to the agent. Version 2 adds ticket re-check tasks (repeated reads of slow-changing data after a time gap), used by the Stage 7 learning engine; the first 18 tasks are unchanged from version 1.",
  "tasks": [
    {
      "id": "redundant_orbit_price",
      "category": "redundant",
      "split": "train",
      "task": "How much does Orbit cost per user per month on the monthly plan? Answer in USD.",
      "tools": [
        "kb_search",
        "doc_read"
      ],
      "script": [
        {
          "tool_calls": [
            {
              "name": "kb_search",
              "args": {
                "query": "Orbit price"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "kb_search",
              "args": {
                "query": "orbit price"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "doc_read",
              "args": {
                "doc_id": "kb-002"
              }
            }
          ]
        },
        {
          "tool_calls": [
            {
              "name": "doc_read",
              "args": {
                "doc_id": "kb-002"
              }
            }
          ]
        },
        {
          "answer_template": "Orbit costs {p} USD per user per month.",
          "values": {
            "p": {
              "tool": "doc_read",
              "path": "result.body",
              "regex": "costs (\\d+) USD per user per month"
            }
          }
        }
      ],
      "expected": {
        "answer": {
          "numbers": [
            {
              "value": 29
            }
          ]
        }
      }
    },
    {
