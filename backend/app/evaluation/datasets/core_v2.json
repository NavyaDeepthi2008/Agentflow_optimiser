            "p": {
              "tool": "price_lookup",
              "path": "result.price"
            }
          }
        }
      ],
      "expected": {
        "answer": {
          "numbers": [
            {
              "value": 45.91,
              "tolerance": 0.001
            }
          ],
          "contains_none": [
            "45.18"
          ]
        }
      }
    },
