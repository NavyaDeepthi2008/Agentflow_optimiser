    {
      "cache_scope": "run",
      "description": "Change one field (status, owner or note) of a ticket record. This modifies data.",
      "effect": "side_effect",
      "effective_cache_scope": "run",
      "effective_ttl_seconds": null,
      "freshness": "live",
      "learned_rules": [],
      "learning_eligible": false,
      "max_ttl_seconds": null,
      "name": "record_update",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "description": "Which field to change.",
            "enum": [
              "status",
              "owner",
              "note"
            ],
            "type": "string"
          },
          "record_id": {
            "description": "Record id, e.g. 'REC-1001'.",
            "pattern": "^REC-\\d{4}$",
            "type": "string"
          },
          "value": {
            "description": "New value. For status: open, in_progress, resolved or closed.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "record_id",
          "field",
          "value"
        ],
        "type": "object"
      },
      "requires_permission": true,
      "timeout_seconds": 5.0,
      "ttl_seconds": null
    },
    {
      "cache_scope": "run",
      "description": "Send a notification message to a team or user. This performs an action.",
      "effect": "side_effect",
      "effective_cache_scope": "run",
      "effective_ttl_seconds": null,
      "freshness": "live",
      "learned_rules": [],
      "learning_eligible": false,
      "max_ttl_seconds": null,
      "name": "send_notification",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "idempotency_key": {
            "description": "Optional key; repeating a key returns the original message instead of sending again.",
            "pattern": "^[A-Za-z0-9_-]{8,64}$",
            "type": "string"
          },
          "message": {
            "description": "Message text.",
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "recipient": {
            "description": "Recipient, e.g. 'team:billing' or 'user:asha'.",
            "pattern": "^(team|user):[a-z0-9_-]{1,32}$",
            "type": "string"
          }
        },
        "required": [
          "recipient",
          "message"
        ],
        "type": "object"
      },
      "requires_permission": true,
      "timeout_seconds": 5.0,
      "ttl_seconds": null
    }
