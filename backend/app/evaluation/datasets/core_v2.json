    {
      "id": "freshness_price_changed",
      "category": "freshness",
      "split": "train",
      "scripted_only": true,
      "task": "What is the current price of ORB-X? Check it, then check again a few minutes later and report the latest value.",
      "tools": [
        "price_lookup"
      ],
      "script": [
        {
          "tool_calls": [
            {
              "name": "price_lookup",
              "args": {
                "symbol": "ORB-X"
              }
            }
          ]
        },
        {
          "advance_seconds": 400,
          "tool_calls": [
            {
              "name": "price_lookup",
              "args": {
                "symbol": "ORB-X"
              }
            }
          ]
