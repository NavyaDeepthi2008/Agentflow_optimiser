            "type": "boolean"
          },
          "limit": {
            "default": 3,
            "description": "Maximum number of results.",
            "maximum": 10,
            "minimum": 1,
            "type": "integer"
          },
          "query": {
            "description": "What to search for.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "requires_permission": false,
      "timeout_seconds": 5.0,
      "ttl_seconds": 3600.0
